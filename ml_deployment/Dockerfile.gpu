# GPU-enabled Docker image for ML Model Deployment
# Based on NVIDIA CUDA runtime
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04 as production

WORKDIR /app

# Install Python and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3.11 /usr/bin/python

# Create non-root user
RUN groupadd -r mlservice && useradd -r -g mlservice mlservice

# Copy requirements and install
COPY requirements.txt .

# Install GPU-enabled packages
RUN pip install --no-cache-dir \
    fastapi>=0.109.0 \
    uvicorn[standard]>=0.27.0 \
    pydantic>=2.5.0 \
    numpy>=1.24.0 \
    onnxruntime-gpu>=1.16.0 \
    prometheus-client>=0.19.0 \
    python-dotenv>=1.0.0

# Copy application code
COPY app/ ./app/
COPY configs/ ./configs/

# Create models directory
RUN mkdir -p /app/models && chown -R mlservice:mlservice /app

# Switch to non-root user
USER mlservice

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MODEL_PATH="" \
    MODEL_NAME="default" \
    HOST="0.0.0.0" \
    PORT="8000" \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/live')" || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
