{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "conversation-record",
  "description": "Canonical schema for normalized conversation records across all platforms.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier in format platform:identifier"
    },
    "platform": {
      "type": "string",
      "description": "Source platform (slack, box, dropbox, chatgpt, email, etc.)"
    },
    "thread_id": {
      "type": ["string", "null"],
      "description": "Parent thread identifier, if applicable"
    },
    "participants": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of participant identifiers"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "description": "Unique message identifier"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "author": {
            "type": "string",
            "description": "Author identifier"
          },
          "text": {
            "type": "string",
            "description": "Message text content"
          },
          "attachments": {
            "type": "array",
            "items": {"type": "string"},
            "description": "List of attachment paths or references"
          }
        },
        "required": ["message_id", "timestamp", "author", "text"]
      }
    },
    "provenance": {
      "type": "object",
      "description": "Provenance metadata for this record"
    }
  },
  "required": ["id", "platform", "participants", "messages"]
}
