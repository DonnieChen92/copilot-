{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/un-ai-gov-conv.schema.json",
  "title": "UN AI Global Governance Convention - Draft Schema",
  "type": "object",
  "required": ["un_ai_global_governance_convention"],
  "properties": {
    "un_ai_global_governance_convention": {
      "type": "object",
      "required": ["meta", "principles", "chapters"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["id", "title_zh", "version", "status", "date", "language", "scope"],
          "properties": {
            "id": { "type": "string" },
            "title_zh": { "type": "string" },
            "version": { "type": "string" },
            "status": { "type": "string", "enum": ["draft", "candidate", "final"] },
            "date": { "type": "string" },
            "language": { "type": "string" },
            "scope": { "type": "string" }
          },
          "additionalProperties": true
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "norm"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "norm": { "type": "string" }
            }
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "articles"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "articles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
